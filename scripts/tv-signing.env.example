# Copia este archivo fuera del repositorio y exporta las variables en tu terminal/CI.
# Nunca guardes claves privadas, contraseñas o certificados reales en Git.
TIZEN_CERT_PROFILE=MilTVPlusTV
WEBOS_PRIVATE_KEY=/secure/path/webos-developer-private-key.pem
WEBOS_KEY_PASSPHRASE=replace-with-secret
# Opcional:
MILTVPLUS_TV_OUT_DIR=/secure/output/miltvplus-smart-tv
