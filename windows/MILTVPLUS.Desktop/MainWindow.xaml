<Window x:Class="MILTVPLUS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="MILTVPLUS" Height="900" Width="1440" MinHeight="680" MinWidth="1050" PreviewKeyDown="Window_PreviewKeyDown" Background="#07132D" Foreground="#F5F8FF" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0B1835" Padding="22">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="MILTVPLUS" FontSize="26" FontWeight="Bold" Foreground="#00D9F5" Margin="0,8,0,4"/>
     <TextBlock Text="ENTRETENIMIENTO" FontSize="10" Foreground="#AAB6CE" Margin="0,0,0,24"/>
     <ListBox x:Name="Sections" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="Sections_SelectionChanged">
      <ListBoxItem Content="Inicio" IsSelected="True" Padding="10"/>
      <ListBoxItem Content="Canales por país" Padding="10"/><ListBoxItem Content="TV en vivo" Padding="10"/><ListBoxItem Content="Películas" Padding="10"/>
      <ListBoxItem Content="Series" Padding="10"/><ListBoxItem Content="Deportes" Padding="10"/>
      <ListBoxItem Content="Radios" Padding="10"/><ListBoxItem Content="Música" Padding="10"/>
      <ListBoxItem Content="Teatro" Padding="10"/><ListBoxItem Content="Guía EPG" Padding="10"/>
     </ListBox>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Fuentes autorizadas · MILTVPLUS" Foreground="#8192B3" FontSize="10" TextWrapping="Wrap" Margin="0,20,0,0"/>
   </DockPanel>
  </Border>
  <Grid x:Name="MainContentGrid" Grid.Column="1" Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,18">
    <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="Tu entretenimiento, en un solo lugar" FontSize="28" FontWeight="Bold"/><TextBlock Text="Aplicación de escritorio nativa para Windows" Foreground="#AAB6CE" Margin="0,5,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Importar M3U/M3U8" Click="ImportM3u_Click" Padding="14,10" Margin="0,0,8,0" Background="#26365D" Foreground="White" BorderThickness="0"/><Button Content="Buscar actualizaciones" Click="CheckUpdates_Click" Padding="14,10" Margin="0,0,8,0" Background="#26365D" Foreground="White" BorderThickness="0"/><Button Content="Actualizar" Click="Refresh_Click" Padding="18,10" Background="#087BFF" Foreground="White" BorderThickness="0"/><Button Content="Pantalla completa" Click="ToggleFullscreen_Click" Padding="14,10" Margin="8,0,0,0" Background="#26365D" Foreground="White" BorderThickness="0"/></StackPanel>
   </DockPanel>
   <DockPanel Grid.Row="1" Margin="0,0,0,14">
    <TextBox x:Name="SearchBox" Width="300" Height="38" VerticalContentAlignment="Center" Background="#101E3D" Foreground="White" BorderBrush="#26365D" TextChanged="SearchBox_TextChanged"/>
    <ComboBox x:Name="CountryFilter" Width="125" Height="38" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged" ToolTip="Filtrar por país"/>
    <ComboBox x:Name="CategoryFilter" Width="145" Height="38" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged" ToolTip="Filtrar por categoría"/>
    <Button Content="◀ Anterior" Click="PreviousAnyChannel_Click" Padding="12,7" Margin="12,0,4,0" Background="#26365D" Foreground="White" BorderThickness="0"/><Button Content="Siguiente ▶" Click="NextAnyChannel_Click" Padding="12,7" Margin="4,0" Background="#26365D" Foreground="White" BorderThickness="0"/><Button Content="Detener" Click="StopAny_Click" Padding="12,7" Margin="4,0" Background="#26365D" Foreground="White" BorderThickness="0"/>
    <TextBlock x:Name="StatusText" Text="Listo" Foreground="#00D9F5" VerticalAlignment="Center" Margin="8,0"/>
   </DockPanel>
   <Border x:Name="VideoContainer" Grid.Row="2" Background="#020817" BorderBrush="#26365D" BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,0,0,14">
    <Grid>
     <vlc:VideoView x:Name="VideoSurface" Visibility="Visible"/>
     <wv2:WebView2 x:Name="OfficialWebView" Visibility="Collapsed"/>
    </Grid>
   </Border>
   <ScrollViewer x:Name="CatalogScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Catalog"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="#101E3D" BorderBrush="#26365D" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
     <DockPanel LastChildFill="True">
      <Image DockPanel.Dock="Left" Width="76" Height="50" Margin="0,0,14,0" Stretch="Uniform" Source="{Binding LogoUrl}"/>
      <Button DockPanel.Dock="Right" Content="Ver canal" Click="Watch_Click" Padding="14,8" Margin="12,0,0,0" Background="#087BFF" Foreground="White" BorderThickness="0"/>
      <StackPanel><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="#AAB6CE" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding Metadata}" Foreground="#00D9F5" Margin="0,8,0,0"/></StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
 </Grid>
</Window>