<Window x:Class="MILTVPLUS.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="MILTVPLUS" Height="920" Width="1480" MinHeight="560" MinWidth="760"
 PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged" Background="#050812" Foreground="#F5F8FF"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#D9D5E2"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="12,10"/>
   <Setter Property="Margin" Value="0,2"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="ItemBorder" Property="Background">
         <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#94104F"/><GradientStop Color="#42102F" Offset="1"/></LinearGradientBrush></Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#68405B"/>
        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#20233A"/>
   <Setter Property="BorderBrush" Value="#46334D"/>
   <Setter Property="Padding" Value="13,8"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="SidebarPanel" Grid.Column="0" Background="#08060D" BorderBrush="#38283E" BorderThickness="0,0,1,0" Padding="12">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="5,8,5,14">
     <TextBlock FontSize="25" FontWeight="Black" Margin="2,0,0,3">
      <Run Text="MIL" Foreground="White"/><Run Text="TV" Foreground="#38BDF8"/><Run Text="PLUS" Foreground="#EC4899"/>
     </TextBlock>
     <TextBlock Text="Tu mundo en una sola app 🇦🇷" FontSize="10" Foreground="#B8AFC6"/>
     <Separator Margin="0,16,0,8" Background="#34283B"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Margin="2,10,2,2" Padding="10" CornerRadius="13" BorderBrush="#A8792A" BorderThickness="1">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#49300D"/><GradientStop Color="#1C1020" Offset="1"/></LinearGradientBrush></Border.Background>
     <StackPanel HorizontalAlignment="Center">
      <TextBlock Text="♛" FontSize="25" Foreground="#FFC247" HorizontalAlignment="Center"/>
      <TextBlock Text="MILTVPLUS · 100 % GRATIS" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
      <TextBlock Text="Sin anuncios · Sin pagos · Sin suscripciones" FontSize="9" Foreground="#FFD98A" HorizontalAlignment="Center" Margin="0,3,0,5"/>
      <Border Height="5" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7DD3FC"/><GradientStop Color="White" Offset=".5"/><GradientStop Color="#7DD3FC" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <TextBlock Text="🇦🇷" HorizontalAlignment="Center" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
    <ListBox x:Name="Sections" Background="Transparent" BorderThickness="0" Foreground="White"
             SelectionChanged="Sections_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBoxItem Content="⌂   Inicio" Tag="Inicio" IsSelected="True"/>
     <ListBoxItem Content="▣   TV en Vivo" Tag="TV en vivo"/>
     <ListBoxItem Content="▦   Guía EPG" Tag="Guía EPG"/>
     <ListBoxItem Content="▤   Películas" Tag="Películas"/>
     <ListBoxItem Content="▧   Series" Tag="Series"/>
     <ListBoxItem Content="🏆   Deportes" Tag="Deportes"/>
     <ListBoxItem Content="☺   Infantil" Tag="Infantil"/>
     <ListBoxItem Content="▤   Documentales" Tag="Documentales"/>
     <ListBoxItem Content="♫   Música" Tag="Música"/>
     <ListBoxItem Content="◉   Radios" Tag="Radios"/>
     <ListBoxItem Content="▣   Teatro" Tag="Teatro"/>
     <ListBoxItem Content="◎   Países" Tag="Países"/>
     <ListBoxItem Content="🔞   Adultos 18+" Tag="Adultos 18+"/>
     <ListBoxItem Content="☆   Favoritos" Tag="Favoritos"/>
     <ListBoxItem Content="⚙   Configuración" Tag="Configuración"/>
     <ListBoxItem Content="•••   Más Opciones" Tag="Más Opciones"/>
    </ListBox>
    <TextBlock DockPanel.Dock="Bottom" Text="Señales públicas y fuentes autorizadas" Foreground="#8192B3" FontSize="9" TextWrapping="Wrap" Margin="5,8,5,0"/>
   </DockPanel>
  </Border>
  <Grid x:Name="MainContentGrid" Grid.Column="1" Margin="22">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="2*"/>
    <RowDefinition Height="3*"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
     <StackPanel>
      <TextBlock x:Name="ClockTime" Text="--:--" FontSize="19" FontWeight="Bold" Foreground="White"/>
      <TextBlock x:Name="ClockDate" Text="Cargando fecha…" FontSize="9" Foreground="#AAB6CE"/>
     </StackPanel>
    </StackPanel>
    <ScrollViewer x:Name="ToolbarScroll" DockPanel.Dock="Right" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="720">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="♧" ToolTip="Notificaciones" Click="OpenNotifications_Click" Padding="10,7"/>
     <Button Content="⚙" ToolTip="Configuración" Click="OpenSettings_Click" Padding="10,7"/>
     <Button Content="◉" ToolTip="Mi perfil" Click="OpenAccount_Click" Padding="10,7"/>
     <Button Content="Importar M3U/M3U8" Click="ImportM3u_Click" Background="#26365D"/>
     <Button Content="Buscar actualizaciones" Click="CheckUpdates_Click" Background="#26365D"/>
     <Button Content="Actualizar" Click="Refresh_Click" Background="#087BFF"/>
     <Button Content="Pantalla completa" Click="ToggleFullscreen_Click" Background="#26365D"/>
    </StackPanel>
    </ScrollViewer>
    <TextBox x:Name="SearchBox" Width="220" Height="38" Margin="0,0,12,0" VerticalContentAlignment="Center"
             Background="#101E3D" Foreground="White" BorderBrush="#493D50"
             ToolTip="Buscar en MILTVPLUS" TextChanged="SearchBox_TextChanged"/>
   </DockPanel>
   <StackPanel x:Name="HomePanel" Grid.Row="1" Margin="0,0,0,14">
    <Border CornerRadius="18" Padding="22" Margin="0,0,0,10" Height="176" BorderBrush="#1B4D85" BorderThickness="1">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#031437"/><GradientStop Color="#075DB4" Offset=".55"/><GradientStop Color="#06152F" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
       <TextBlock Text="🇦🇷  MILTVPLUS · ARGENTINA Y EL MUNDO" Foreground="#16C8F2" FontSize="10" FontWeight="Bold"/>
       <TextBlock Text="Bienvenido a" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
       <TextBlock Text="MILTVPLUS" Foreground="White" FontSize="32" FontWeight="Black"/>
       <Border Width="62" Height="4" HorizontalAlignment="Left" Background="#16C8F2" CornerRadius="3" Margin="0,2,0,7"/>
       <TextBlock Text="La mejor experiencia IPTV en Argentina y el mundo" Foreground="White" FontSize="12"/>
       <TextBlock Text="✓ TV en Vivo · Películas · Series     ✓ Canales públicos del mundo     ✓ Guía EPG y Favoritos" Foreground="#D8EEFF" FontSize="10" Margin="0,6,0,0"/>
       <Button Content="▶  Ver Televisión" Click="QuickNavigation_Click" Tag="TV en vivo" Background="#087BFF" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="16,7"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock Text="☀" Foreground="#FFC247" FontSize="38" HorizontalAlignment="Center"/>
       <TextBlock Text="🇦🇷" FontSize="38" HorizontalAlignment="Center"/>
       <TextBlock Text="ARGENTINA · 10" Foreground="#BDEBFF" FontSize="10" FontWeight="Bold"/>
       <TextBlock Text="⚽" Foreground="White" FontSize="42" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
    </Border>
    <UniformGrid Columns="6">
     <Button Content="▣&#x0a;TV en Vivo&#x0a;Canales HD" Tag="TV en vivo" Click="QuickNavigation_Click" Background="#073D83" Margin="3" Padding="8"/>
     <Button Content="▤&#x0a;Películas&#x0a;Estrenos y clásicos" Tag="Películas" Click="QuickNavigation_Click" Background="#32166A" Margin="3" Padding="8"/>
     <Button Content="▧&#x0a;Series&#x0a;Tus favoritas" Tag="Series" Click="QuickNavigation_Click" Background="#07513C" Margin="3" Padding="8"/>
     <Button Content="🏆&#x0a;Deportes&#x0a;Todo el deporte" Tag="Deportes" Click="QuickNavigation_Click" Background="#66320A" Margin="3" Padding="8"/>
     <Button Content="☺&#x0a;Infantiles&#x0a;Para los más chicos" Tag="Infantil" Click="QuickNavigation_Click" Background="#5C174B" Margin="3" Padding="8"/>
     <Button Content="◎&#x0a;Países&#x0a;Elegí tu región" Tag="Países" Click="QuickNavigation_Click" Background="#064B65" Margin="3" Padding="8"/>
    </UniformGrid>
   </StackPanel>
   <StackPanel x:Name="MusicPanel" Grid.Row="1" Margin="0,0,0,14" Visibility="Collapsed">
    <Border CornerRadius="20" Padding="24" Height="150" BorderBrush="#7048A8" BorderThickness="1">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#39205D"/><GradientStop Color="#19132F" Offset=".58"/><GradientStop Color="#35152F" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="MILTVPLUS SOUND  ·  UN AMBIENTE HECHO PARA ESCUCHAR" Foreground="#FFC5E3" FontSize="10" FontWeight="Bold"/>
       <TextBlock Text="Bajá el ruido. Subí el volumen." Foreground="White" FontSize="28" FontWeight="Black" Margin="0,8,0,5"/>
       <TextBlock Text="Descubrí música publicada y escuchá streams autorizados. Las fuentes externas se abren en su servicio oficial." Foreground="#E0D9EE" FontSize="11"/>
       <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="Buscar en YouTube Music" Click="SearchYouTubeMusic_Click" Background="#30234A"/>
        <Button Content="Buscar en Spotify" Click="SearchSpotify_Click" Background="#30234A"/>
       </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="♫" Foreground="#FF68B4" FontSize="64" VerticalAlignment="Center" Margin="20,0"/>
     </Grid>
    </Border>
   </StackPanel>
   <StackPanel x:Name="SettingsPanel" Grid.Row="1" Margin="0,0,0,14" Visibility="Collapsed">
    <Border CornerRadius="20" Padding="22" BorderBrush="#34496D" BorderThickness="1" Background="#10182A">
     <StackPanel>
      <TextBlock Text="TU ESPACIO, A TU MANERA" Foreground="#7DD3FC" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Configuración de MILTVPLUS" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,5,0,3"/>
      <TextBlock Text="Ajustá el comportamiento de esta computadora. Los cambios se guardan en este dispositivo." Foreground="#B8C6DF" FontSize="11" Margin="0,0,0,18"/>
      <CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="Buscar actualizaciones al iniciar" Foreground="White" Margin="0,6"/>
      <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Mantener MILTVPLUS siempre visible" Foreground="White" Margin="0,6"/>
      <CheckBox x:Name="StartMaximizedCheckBox" Content="Iniciar la aplicación maximizada" Foreground="White" Margin="0,6"/>
      <TextBlock Text="Volumen del reproductor" Foreground="White" FontWeight="SemiBold" Margin="0,16,0,4"/>
      <Slider x:Name="DesktopVolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="10" IsSnapToTickEnabled="False"/>
      <TextBlock Text="El volumen se aplica al reproductor multimedia integrado." Foreground="#9EACC5" FontSize="10" Margin="0,0,0,14"/>
      <Button Content="Guardar configuración" Click="SaveDesktopSettings_Click" Background="#1763A8" HorizontalAlignment="Left" Padding="18,9"/>
     </StackPanel>
    </Border>
   </StackPanel>
   <StackPanel x:Name="AdultPanel" Grid.Row="1" Margin="0,0,0,14" Visibility="Collapsed">
    <Border CornerRadius="17" Padding="16" Height="118" BorderBrush="#9E1C63" BorderThickness="1" Margin="0,0,0,8">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#570B36"/><GradientStop Color="#21051E" Offset=".6"/><GradientStop Color="#090611" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="76" Height="76" CornerRadius="38" Background="#35102B" BorderBrush="#FF4D9D" BorderThickness="2" VerticalAlignment="Center">
       <TextBlock Text="18+" Foreground="White" FontSize="27" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
       <TextBlock Text="♛  CONTENIDO ADULTO" Foreground="#FFC247" FontSize="10" FontWeight="Bold"/>
       <TextBlock Text="Experiencia privada +18" Foreground="White" FontSize="24" FontWeight="Black"/>
       <TextBlock Text="Solo publicaciones clasificadas y verificadas · Acceso protegido por PIN" Foreground="#FFD8E9" FontSize="11"/>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="♡" Foreground="#FF4D9D" FontSize="42" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <UniformGrid Columns="6" Margin="0,0,0,7">
     <Button Content="💋&#x0a;Romance" Tag="Romance" Click="AdultCategory_Click" Background="#6A1454" Margin="2"/>
     <Button Content="🔥&#x0a;Eróticos" Tag="Eróticos" Click="AdultCategory_Click" Background="#65152F" Margin="2"/>
     <Button Content="💞&#x0a;Parejas" Tag="Parejas" Click="AdultCategory_Click" Background="#511044" Margin="2"/>
     <Button Content="⭐&#x0a;Hot" Tag="Hot" Click="AdultCategory_Click" Background="#5C183C" Margin="2"/>
     <Button Content="💎&#x0a;Premium" Tag="Premium" Click="AdultCategory_Click" Background="#102E70" Margin="2"/>
     <Button Content="🔞&#x0a;Solo Adultos" Tag="Solo Adultos" Click="AdultCategory_Click" Background="#68152A" Margin="2"/>
    </UniformGrid>
    <DockPanel Margin="2,3,2,5">
     <TextBlock Text="▶  Recomendados para vos" Foreground="White" FontSize="16" FontWeight="Bold"/>
     <TextBlock Text="Basados en el catálogo real publicado" Foreground="#FF9CCB" FontSize="10" HorizontalAlignment="Right"/>
    </DockPanel>
    <UniformGrid Columns="4">
     <TextBlock Text="🛡  Contenido seguro" Foreground="#FFD8E9" FontSize="9" Margin="5"/>
     <TextBlock Text="🔒  Acceso exclusivo +18" Foreground="#FFD8E9" FontSize="9" Margin="5"/>
     <TextBlock Text="♛  Calidad según la fuente" Foreground="#FFD8E9" FontSize="9" Margin="5"/>
     <TextBlock Text="♡  Experiencia privada" Foreground="#FFD8E9" FontSize="9" Margin="5"/>
    </UniformGrid>
   </StackPanel>
   <DockPanel Grid.Row="2" Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Left">
     <TextBlock x:Name="PageTitle" Text="Tu entretenimiento, en un solo lugar" FontSize="21" FontWeight="Bold"/>
     <TextBlock Text="Catálogo publicado y fuentes autorizadas" Foreground="#AAB6CE" FontSize="10" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <ComboBox x:Name="CountryFilter" Width="125" Height="36" Margin="4,0" VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged" ToolTip="Filtrar por país"/>
     <ComboBox x:Name="CategoryFilter" Width="145" Height="36" Margin="4,0" VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged" ToolTip="Filtrar por categoría"/>
     <Button Content="◀ Anterior" Click="PreviousAnyChannel_Click" Padding="10,7"/>
     <Button Content="Siguiente ▶" Click="NextAnyChannel_Click" Padding="10,7"/>
     <Button Content="Detener" Click="StopAny_Click" Padding="10,7"/>
     <TextBlock x:Name="StatusText" Text="Listo" Foreground="#00D9F5" VerticalAlignment="Center" Margin="8,0"/>
    </StackPanel>
   </DockPanel>
   <Border x:Name="VideoContainer" Grid.Row="3" Background="#020817" BorderBrush="#493D50" BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,0,0,12">
    <Grid>
     <vlc:VideoView x:Name="VideoSurface" Visibility="Visible"/>
     <wv2:WebView2 x:Name="OfficialWebView" Visibility="Collapsed"/>
    </Grid>
   </Border>
   <ScrollViewer x:Name="CatalogScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="Catalog">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Background="#101E3D" BorderBrush="#26365D" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,9">
        <DockPanel LastChildFill="True">
         <Image DockPanel.Dock="Left" Width="76" Height="50" Margin="0,0,14,0" Stretch="Uniform" Source="{Binding LogoUrl}"/>
         <Button DockPanel.Dock="Right" Content="Ver canal" Click="Watch_Click" Padding="14,8" Margin="12,0,0,0" Background="#087BFF"/>
         <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="{Binding Description}" Foreground="#AAB6CE" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Metadata}" Foreground="#00D9F5" Margin="0,7,0,0"/>
         </StackPanel>
        </DockPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <Border x:Name="AdultGatePanel" Grid.Row="3" Grid.RowSpan="2" Panel.ZIndex="5" Visibility="Collapsed"
           Background="#160611" BorderBrush="#8F175A" BorderThickness="1" CornerRadius="18" Padding="28" Margin="0,0,0,12">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
     <TextBlock Text="18+" Foreground="#FF5DAA" FontSize="42" FontWeight="Black" HorizontalAlignment="Center"/>
     <TextBlock Text="Contenido Adulto" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
     <TextBlock Text="Acceso privado · Solo mayores de 18 años" Foreground="#FFD8E9" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,18"/>
     <CheckBox x:Name="AdultAgeConfirm" Content="Confirmo que tengo 18 años o más" Foreground="White" Margin="0,0,0,12"/>
     <PasswordBox x:Name="AdultPinBox" MaxLength="6" Height="38" Background="#21101F" Foreground="White" BorderBrush="#A52A69" ToolTip="PIN parental de seis dígitos"/>
     <Button Content="Confirmar y desbloquear" Click="AdultUnlock_Click" Background="#D91D78" Margin="0,12,0,0"/>
     <TextBlock x:Name="AdultGateStatus" Foreground="#FFD8E9" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
     <TextBlock Text="El catálogo muestra únicamente publicaciones clasificadas +18. El acceso se protege con confirmación de edad y PIN local." Foreground="#B8AFC6" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>